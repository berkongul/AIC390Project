# Copy to .env and fill in. .env is ignored by git (rule R13).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# 1 = send only the first request (smoke test), 0 = full run of 75 requests
DRY_RUN=0

# Week 2 evaluation: pause after every Groq call, in seconds (free-tier rate limits)
WEEK2_PAUSE_SECONDS=15
# Groq list price for openai/gpt-oss-20b, USD per 1M tokens (console.groq.com/docs/model/openai/gpt-oss-20b,
# checked 11 Nov 2026). Check again before a run and update if it changed.
GROQ_INPUT_USD_PER_MILLION=0.075
GROQ_OUTPUT_USD_PER_MILLION=0.30
